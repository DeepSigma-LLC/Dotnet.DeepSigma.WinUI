<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeepSigma.WinUI</RootNamespace>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>DeepSigma.WinUI</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.9.0.0</Version>
    <Authors>DeepSigma LLC</Authors>
    <Description>A general C# WinUI package library.</Description>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.WinUI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.WinUI</RepositoryUrl>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="TableViewControl.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DeepSigma.Charting" Version="1.2.0" />
    <PackageReference Include="DeepSigma.Core" Version="1.6.2" />
    <PackageReference Include="H.OxyPlot.WinUI" Version="0.9.30" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="PlotControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="TableViewControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the image next to the generated resource index (.pri) under
         lib\<tfm>\DeepSigma.WinUI\Assets\ so it resolves as
         ms-appx:///DeepSigma.WinUI/Assets/DeepSigma.png in consuming apps. The default SDK behavior
         packs Content images into contentFiles\, which does NOT match the path the .pri records, so
         consumers fail at build with MSB3030 (asset not found under lib). The tfm folder must match the
         NuGet short-folder name for TargetFramework (net10.0-windows10.0.19041.0 -> net10.0-windows10.0.19041). -->
    <Content Update="Assets\DeepSigma.png">
      <Pack>true</Pack>
      <PackagePath>lib\net10.0-windows10.0.19041\DeepSigma.WinUI\Assets\DeepSigma.png</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>