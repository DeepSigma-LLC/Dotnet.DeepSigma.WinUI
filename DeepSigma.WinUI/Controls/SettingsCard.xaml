<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeepSigma.WinUI.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DeepSigma.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:Card CardPadding="16,12,16,12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- icon -->
                <ColumnDefinition Width="*"/>
                <!-- header + description -->
                <ColumnDefinition Width="Auto"/>
                <!-- the control -->
            </Grid.ColumnDefinitions>

            <ContentPresenter
                Grid.Column="0"
                Content="{x:Bind HeaderIcon, Mode=OneWay}"
                VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Header, Mode=OneWay}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextWrapping="Wrap"/>
                <TextBlock
                    Text="{x:Bind Description, Mode=OneWay}"
                    Visibility="{x:Bind HasText(Description), Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,2,0,0"/>
            </StackPanel>

            <ContentPresenter
                Grid.Column="2"
                Content="{x:Bind SettingsContent, Mode=OneWay}"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Right"/>
        </Grid>
    </controls:Card>
</UserControl>
